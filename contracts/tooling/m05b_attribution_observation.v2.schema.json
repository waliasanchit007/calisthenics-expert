{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calisthenics-expert.local/contracts/tooling/m05b_attribution_observation.v2.schema.json",
  "title": "M0.5B attribution v2 device observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_schema_version", "record_kind", "protocol_sha256", "sanitized", "non_participant_observation", "device", "identity", "source_arm", "backend_arm", "selector_arm", "end_to_end_replicates", "blocking_codes"],
  "properties": {
    "evidence_schema_version": {"const": "2.0.0"},
    "record_kind": {"const": "m05b_attribution_v2_device_observation"},
    "protocol_sha256": {"$ref": "#/$defs/sha256"},
    "sanitized": {"const": true},
    "non_participant_observation": {"const": true},
    "device": {"$ref": "#/$defs/device"},
    "identity": {"$ref": "#/$defs/identity"},
    "source_arm": {"$ref": "#/$defs/source_arm"},
    "backend_arm": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/backend_arm"}]},
    "selector_arm": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/selector_arm"}]},
    "end_to_end_replicates": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/replicate"}},
    "blocking_codes": {"$ref": "#/$defs/blocking_codes"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "blocking_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^ATTRIBUTION\\.[A-Z0-9_]+$"}},
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_class", "device_identity", "manufacturer", "model", "api_level", "android_release", "os_build"],
      "properties": {
        "device_class": {"const": "physical_device"},
        "device_identity": {"type": "string", "minLength": 1},
        "manufacturer": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "api_level": {"type": "integer", "minimum": 1},
        "android_release": {"type": "string", "minLength": 1},
        "os_build": {"type": "string", "minLength": 1}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_git_sha", "probe_git_sha", "app_apk_sha256", "test_apk_sha256", "model_sha256", "runtime_version", "backend_version", "delegate"],
      "properties": {
        "app_git_sha": {"$ref": "#/$defs/git_sha"},
        "probe_git_sha": {"$ref": "#/$defs/git_sha"},
        "app_apk_sha256": {"$ref": "#/$defs/sha256"},
        "test_apk_sha256": {"$ref": "#/$defs/sha256"},
        "model_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_version": {"type": "string", "minLength": 1},
        "backend_version": {"type": "string", "minLength": 1},
        "delegate": {"type": "string", "minLength": 1}
      }
    },
    "source_arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blocking_codes", "warmup_count", "measured_count", "timestamps_ns", "observed_ae_target_fps", "thermal_status", "initial_cooldown_thermal_statuses", "initial_cooldown_recovered"],
      "properties": {
        "status": {"enum": ["recorded", "blocked"]},
        "blocking_codes": {"$ref": "#/$defs/blocking_codes"},
        "warmup_count": {"type": "integer", "minimum": 0},
        "measured_count": {"type": "integer", "minimum": 0},
        "timestamps_ns": {"type": "array", "maxItems": 300, "items": {"type": "integer", "minimum": 0}},
        "observed_ae_target_fps": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/fps_range"}]},
        "thermal_status": {"type": "integer", "minimum": 0},
        "initial_cooldown_thermal_statuses": {"type": "array", "maxItems": 601, "items": {"type": "integer", "minimum": 0}},
        "initial_cooldown_recovered": {"anyOf": [{"type": "null"}, {"type": "boolean"}]}
      }
    },
    "backend_arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blocking_codes", "warmup_count", "warmup_elapsed_ns", "measured_count", "service_durations_ns", "inference_failures", "thermal_status", "arm_started_ns", "warmup_predicates", "delivered_callback_ids", "terminal_callbacks", "submitted_inference_ids", "pending_inference_ids", "raw_evidence_overflow"],
      "properties": {
        "status": {"enum": ["recorded", "blocked"]},
        "blocking_codes": {"$ref": "#/$defs/blocking_codes"},
        "warmup_count": {"type": "integer", "minimum": 0},
        "warmup_elapsed_ns": {"type": "integer", "minimum": 0},
        "measured_count": {"type": "integer", "minimum": 0},
        "service_durations_ns": {"type": "array", "maxItems": 100, "items": {"type": "integer", "minimum": 0}},
        "inference_failures": {"type": "integer", "minimum": 0},
        "thermal_status": {"type": "integer", "minimum": 0},
        "arm_started_ns": {"type": "integer", "minimum": 0},
        "warmup_predicates": {"$ref": "#/$defs/warmup_predicates"},
        "delivered_callback_ids": {"type": "array", "maxItems": 300, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "terminal_callbacks": {"type": "array", "maxItems": 300, "items": {"$ref": "#/$defs/callback"}},
        "submitted_inference_ids": {"type": "array", "maxItems": 300, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "pending_inference_ids": {"type": "array", "maxItems": 300, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "raw_evidence_overflow": {"type": "boolean"}
      }
    },
    "warmup_predicates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completion_count", "elapsed_ns", "completion_count_satisfied", "elapsed_satisfied"],
      "properties": {
        "completion_count": {"type": "integer", "minimum": 0},
        "elapsed_ns": {"type": "integer", "minimum": 0},
        "completion_count_satisfied": {"type": "boolean"},
        "elapsed_satisfied": {"type": "boolean"}
      }
    },
    "fps_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": {"lower": {"type": "integer", "minimum": 1}, "upper": {"type": "integer", "minimum": 1}}
    },
    "selector_arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authoritative", "blocking_codes", "runs"],
      "properties": {
        "status": {"enum": ["recorded", "blocked"]},
        "authoritative": {"const": false},
        "blocking_codes": {"$ref": "#/$defs/blocking_codes"},
        "runs": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/selector_run"}}
      }
    },
    "selector_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cadence_fps", "production_selected_timestamps_ns", "host_selected_timestamps_ns"],
      "properties": {
        "cadence_fps": {"enum": [10, 15, 30]},
        "production_selected_timestamps_ns": {"type": "array", "maxItems": 300, "items": {"type": "integer", "minimum": 0}},
        "host_selected_timestamps_ns": {"type": "array", "maxItems": 300, "items": {"type": "integer", "minimum": 0}}
      }
    },
    "replicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "status", "blocking_codes", "cooldown_thermal_statuses", "runs"],
      "properties": {
        "order": {"enum": [[10, 15, 30], [30, 15, 10]]},
        "status": {"enum": ["recorded", "blocked"]},
        "blocking_codes": {"$ref": "#/$defs/blocking_codes"},
        "cooldown_thermal_statuses": {"type": "array", "maxItems": 601, "items": {"type": "integer", "minimum": 0}},
        "runs": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/end_to_end_run"}}
      }
    },
    "end_to_end_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cadence_fps", "session_reference", "initial_thermal_status", "final_thermal_status", "measured_span_ns", "delivered_callback_ids", "terminal_callbacks", "submitted_inference_ids", "pending_inference_ids"],
      "properties": {
        "cadence_fps": {"enum": [10, 15, 30]},
        "session_reference": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "initial_thermal_status": {"type": "integer", "minimum": 0},
        "final_thermal_status": {"type": "integer", "minimum": 0},
        "measured_span_ns": {"type": "integer", "minimum": 0},
        "delivered_callback_ids": {"type": "array", "maxItems": 300, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "terminal_callbacks": {"type": "array", "maxItems": 300, "items": {"$ref": "#/$defs/callback"}},
        "submitted_inference_ids": {"type": "array", "maxItems": 300, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "pending_inference_ids": {"type": "array", "maxItems": 300, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}
      }
    },
    "callback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callback_id", "capture_timestamp_ns", "production_classification", "cadence_due", "slot_available", "terminal_class", "phase", "completion_timestamp_ns"],
      "properties": {
        "callback_id": {"type": "integer", "minimum": 0},
        "capture_timestamp_ns": {"type": "integer", "minimum": 0},
        "production_classification": {"enum": ["submit", "cadence_selection", "backpressure", "preprocessing_failed", "session_stopping"]},
        "cadence_due": {"type": "boolean"},
        "slot_available": {"type": "boolean"},
        "terminal_class": {"enum": ["admitted_completed", "admitted_inference_failed", "cadence_only", "backpressure_only", "cadence_and_backpressure", "preprocessing_failed", "session_stopping", "admission_state_divergence"]},
        "phase": {"enum": ["warmup", "measured"]},
        "completion_timestamp_ns": {"anyOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]}
      }
    }
  }
}
