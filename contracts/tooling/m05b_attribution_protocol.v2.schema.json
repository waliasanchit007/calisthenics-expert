{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calisthenics-expert.local/contracts/tooling/m05b_attribution_protocol.v2.schema.json",
  "title": "M0.5B attribution protocol v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "record_kind", "target_cadences_fps", "source", "backend", "arm_cap_ns", "authorized_device", "cooldown", "environment_operands", "raw_callback_maximum", "replicate_orders", "session_artifacts", "terminal_classes", "clock"],
  "properties": {
    "protocol_version": {"const": "2.1.0"},
    "record_kind": {"const": "m05b_attribution_v2_protocol"},
    "target_cadences_fps": {"const": [10, 15, 30]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmup_callbacks", "measured_callbacks"],
      "properties": {
        "warmup_callbacks": {"const": 30},
        "measured_callbacks": {"const": 300}
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmup_completed", "warmup_elapsed_ns", "measured_completions"],
      "properties": {
        "warmup_completed": {"const": 20},
        "warmup_elapsed_ns": {"const": 2000000000},
        "measured_completions": {"const": 100}
      }
    },
    "arm_cap_ns": {"const": 60000000000},
    "authorized_device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_class", "device_identity", "manufacturer", "model", "api_level", "android_release", "os_build"],
      "properties": {
        "device_class": {"const": "physical_device"},
        "device_identity": {"const": "samsung/SM-S938B/pa3q/pa3qxins"},
        "manufacturer": {"const": "samsung"},
        "model": {"const": "SM-S938B"},
        "api_level": {"const": 36},
        "android_release": {"const": "16"},
        "os_build": {"const": "BP4A.251205.006.S938BXXSBCZG3"}
      }
    },
    "cooldown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampling_interval_ns", "maximum_duration_ns"],
      "properties": {
        "sampling_interval_ns": {"const": 1000000000},
        "maximum_duration_ns": {"const": 600000000000}
      }
    },
    "environment_operands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_fields", "enforced_predicates", "snapshot_fields"],
      "properties": {
        "boundary_fields": {"const": ["arm_started_ns", "arm_ended_ns"]},
        "enforced_predicates": {"const": ["battery_power", "not_charging", "wifi_transport", "screen_keep_awake", "not_device_idle", "valid_monotonic_boundaries", "thermal_recovery", "static_camera_frame_config"]},
        "snapshot_fields": {"const": ["thermal_status", "battery_temperature_c", "battery_level_percent", "power_source", "charging", "wifi_transport", "screen_keep_awake", "device_idle", "negotiated_camera_fps_range", "delivered_width", "delivered_height", "delivered_format"]}
      }
    },
    "raw_callback_maximum": {"const": 1800},
    "replicate_orders": {"const": [[10, 15, 30], [30, 15, 10]]},
    "session_artifacts": {"const": ["manifest", "frames", "telemetry"]},
    "terminal_classes": {
      "const": ["admitted_completed", "admitted_inference_failed", "cadence_only", "backpressure_only", "cadence_and_backpressure", "preprocessing_failed", "session_stopping", "admission_state_divergence"]
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "unit"],
      "properties": {
        "domain": {"const": "session_relative_monotonic"},
        "unit": {"const": "nanoseconds"}
      }
    }
  }
}
