{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calisthenics-expert.local/contracts/tooling/m05b_sustained_run.v1.schema.json",
  "title": "M0.5B sustained run observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["sustained_run_schema_version", "record_kind", "session_id", "session_kind", "attempt_sequence", "cadence_fps", "video_enabled", "camera_fps", "duration_target_ns", "stop_requested_ns", "actual_capture_span_ns", "boundary_events", "artifact_refs", "attempt_chain", "stage_accounting", "latency", "telemetry", "battery", "source_outcome", "process_outcome", "blocking_codes", "non_participant_observation", "sanitized"],
  "properties": {
    "sustained_run_schema_version": {"const": "1.0.0"},
    "record_kind": {"const": "m05b_sustained_run"},
    "session_id": {"type": "string", "pattern": "^00000000-0000-4000-8000-[0-9a-f]{12}$"},
    "session_kind": {"const": "live_conformance"},
    "attempt_sequence": {"type": "integer", "minimum": 1},
    "cadence_fps": {"enum": [10, 15, 30]},
    "video_enabled": {"const": false},
    "camera_fps": {"const": 30},
    "duration_target_ns": {"const": 1500000000000},
    "stop_requested_ns": {"type": "integer", "minimum": 1500000000000},
    "actual_capture_span_ns": {"type": "integer", "minimum": 0},
    "boundary_events": {"type": "array", "const": ["attempt_open", "admission_append", "admission_flush", "admission_fsync", "capture_start"]},
    "artifact_refs": {
      "type": "object", "additionalProperties": false,
      "required": ["envelope", "order", "admission"],
      "properties": {
        "envelope": {"$ref": "#/$defs/artifact_ref"},
        "order": {"$ref": "#/$defs/artifact_ref"},
        "admission": {"$ref": "#/$defs/artifact_ref"}
      }
    },
    "attempt_chain": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/attempt_entry"}},
    "stage_accounting": {
      "type": "object", "additionalProperties": false,
      "required": ["camera_callbacks_received", "yuv_frames_acquired", "yuv_frames_released", "preprocessing_started", "preprocessing_completed", "cadence_admitted", "cadence_rejected", "inference_submitted", "inference_completed", "inference_failed", "pose_records_appended", "pose_records_durable", "source_failures", "process_failures"],
      "properties": {
        "camera_callbacks_received": {"type": "integer", "minimum": 0}, "yuv_frames_acquired": {"type": "integer", "minimum": 0}, "yuv_frames_released": {"type": "integer", "minimum": 0}, "preprocessing_started": {"type": "integer", "minimum": 0}, "preprocessing_completed": {"type": "integer", "minimum": 0}, "cadence_admitted": {"type": "integer", "minimum": 0}, "cadence_rejected": {"type": "integer", "minimum": 0}, "inference_submitted": {"type": "integer", "minimum": 0}, "inference_completed": {"type": "integer", "minimum": 0}, "inference_failed": {"type": "integer", "minimum": 0}, "pose_records_appended": {"type": "integer", "minimum": 0}, "pose_records_durable": {"type": "integer", "minimum": 0}, "source_failures": {"type": "integer", "minimum": 0}, "process_failures": {"type": "integer", "minimum": 0}
      }
    },
    "latency": {
      "type": "object", "additionalProperties": false,
      "required": ["bucket_upper_bounds_ns", "bucket_counts", "percentiles"],
      "properties": {
        "bucket_upper_bounds_ns": {"const": [1000000, 2000000, 4000000, 8000000, 16000000, 32000000, 64000000, 128000000, 256000000, 512000000, 1024000000, 2048000000, 4096000000, null]},
        "bucket_counts": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"type": "integer", "minimum": 0}},
        "percentiles": {"type": "object", "additionalProperties": false, "required": ["50", "95", "99"], "properties": {"50": {"$ref": "#/$defs/latency_bound"}, "95": {"$ref": "#/$defs/latency_bound"}, "99": {"$ref": "#/$defs/latency_bound"}}}
      }
    },
    "telemetry": {
      "type": "object", "additionalProperties": false,
      "required": ["fixed_sample_count", "first_t_session_ns", "last_t_session_ns", "max_inter_sample_gap_ns", "terminal_sample"],
      "properties": {"fixed_sample_count": {"type": "integer", "minimum": 0}, "first_t_session_ns": {"type": "integer", "minimum": 0}, "last_t_session_ns": {"type": "integer", "minimum": 0}, "max_inter_sample_gap_ns": {"type": "integer", "minimum": 0}, "terminal_sample": {"type": "boolean"}}
    },
    "battery": {
      "type": "object", "additionalProperties": false,
      "required": ["start_temperature_c", "end_temperature_c", "delta_temperature_c"],
      "properties": {"start_temperature_c": {"type": "number"}, "end_temperature_c": {"type": "number"}, "delta_temperature_c": {"type": "number"}}
    },
    "source_outcome": {"enum": ["completed", "failed", "lost"]},
    "process_outcome": {"enum": ["completed", "aborted", "failed", "transport_lost"]},
    "blocking_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "non_participant_observation": {"const": true},
    "sanitized": {"const": true}
  },
  "$defs": {
    "artifact_ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "attempt_entry": {"type": "object", "additionalProperties": false, "required": ["entry", "entry_sha256"], "properties": {"entry": {"$ref": "#/$defs/attempt_payload"}, "entry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "attempt_payload": {"type": "object", "additionalProperties": false, "required": ["attempt_entry_schema_version", "record_kind", "attempt_sequence", "cadence_fps", "admission_sha256", "outcome", "previous_entry_sha256"], "properties": {"attempt_entry_schema_version": {"const": "1.0.0"}, "record_kind": {"const": "m05b_attempt_entry"}, "attempt_sequence": {"type": "integer", "minimum": 1}, "cadence_fps": {"enum": [10, 15, 30]}, "admission_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "outcome": {"enum": ["completed", "blocked", "aborted", "failed", "transport_lost"]}, "previous_entry_sha256": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]}}},
    "latency_bound": {"type": "object", "additionalProperties": false, "required": ["lower_inclusive_ns", "upper_inclusive_ns"], "properties": {"lower_inclusive_ns": {"type": "integer", "minimum": 0}, "upper_inclusive_ns": {"type": ["integer", "null"], "minimum": 0}}}
  }
}
